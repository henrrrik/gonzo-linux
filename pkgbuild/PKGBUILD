pkgname=gonzo
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, distraction-free Markdown writing app for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'hunspell')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/gonzo "$pkgdir/usr/bin/gonzo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/gonzo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gonzo.svg"
  install -Dm644 "$startdir/gonzo.desktop" "$pkgdir/usr/share/applications/gonzo.desktop"
}
